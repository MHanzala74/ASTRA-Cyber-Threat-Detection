# ─────────────────────────────────────────────────────────
#  ASTRA - Environment Configuration
#  Copy this file to .env and fill in your values
#  NEVER commit .env to version control!
# ─────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────
APP_ENV=development          # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=1                # Increase in production (e.g. 4)

# ── Security ─────────────────────────────────────────────
# Allowed origins for CORS (comma-separated, no spaces)
# Example: http://localhost:3000,https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# API rate limit (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=60

# ── Blockchain (Ganache) ──────────────────────────────────
GANACHE_URL=http://127.0.0.1:8545

# Fill this AFTER running: python deploy_contract.py
CONTRACT_ADDRESS=

# ── Logging ──────────────────────────────────────────────
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
LOG_FILE=logs/astra.log      # Leave empty to disable file logging

# ── ML Artifacts ─────────────────────────────────────────
ARTIFACTS_DIR=artifacts      # Path to model artifacts folder
